[Unit]
Description=Tragedy Sim room server
After=network.target

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/home/admin/akarin/tragedy-sim
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/admin/akarin/tragedy-sim/.venv/bin/python -m tragedy_sim.server --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
